# From BotFather (/newbot or /token)
TELEGRAM_BOT_TOKEN=your_token_here

# From Google AI Studio -> Get API key
GEMINI_API_KEY=your_key_here

# Optional overrides
GEMINI_SCORE_MODEL=gemini-2.5-flash
GEMINI_DRAFT_MODEL=gemini-2.5-flash
SCORE_THRESHOLD=6
NEWS_LOCALE=IN

# Only this chat id is allowed to use the bot. Leave blank to allow anyone.
ALLOWED_CHAT_ID=

# Secret you invent yourself; passed to Telegram in setWebhook. Blocks strangers hitting your URL.
TELEGRAM_WEBHOOK_SECRET=

# Optional memory layer (B1.3). Leave blank to run without it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
